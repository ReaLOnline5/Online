package main

import "fmt"

func main() {
    var number int
    fmt.Print("Enter number: ")
    fmt.Scan(&number)

    if number > 0 {
        fmt.Println("Number is positive")
    } else if number < 0 {
        fmt.Println("Number is negative")
    } else {
        fmt.Println("Number is zero")
    }
}
